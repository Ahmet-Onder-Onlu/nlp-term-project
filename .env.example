# Copy to .env and fill in. Any OpenAI-compatible endpoint works
# (OpenAI, OpenRouter, Together, a local vLLM server, or Ollama at http://localhost:11434/v1).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: Hugging Face token for faster dataset downloads
HF_TOKEN=

# Optional: external databases (the defaults run fully in-process)
QDRANT_URL=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
